#!/bin/sh
#
# Git credential helper for GitLab over HTTPS (and HTTP on a trusted network).
#
# The launcher forwards GITLAB_TOKEN and GITLAB_HOST into the container. This
# helper answers for https://gitlab.com and, when GITLAB_HOST is set, for the
# host from that URL with any scheme (a self-hosted instance may live on a
# trusted network), so the token is never offered to any other remote.
#
# Installed as /usr/local/bin/git-credential-gitlab and enabled through
# config/gitconfig ([credential] helper = gitlab).

set -eu

[ "${1:-}" = "get" ] || exit 0

token="${GITLAB_TOKEN:-}"
[ -n "$token" ] || exit 0

url="${GITLAB_HOST:-https://gitlab.com}"
scheme="${url%%://*}"
hostport="${url#*://}"
hostport="${hostport%%/*}"
[ -n "$scheme" ] && [ "$scheme" != "$url" ] || exit 0
[ -n "$hostport" ] || exit 0

protocol=""
host=""
while IFS='=' read -r key value; do
  case "$key" in
  protocol) protocol="$value" ;;
  host) host="$value" ;;
  esac
done

# gitlab.com: HTTPS only. The host from $GITLAB_HOST: any scheme, matching the
# Forgejo helper's trusted-network allowance.
if [ "$host" = "gitlab.com" ]; then
  [ "$protocol" = "https" ] || exit 0
elif [ -n "${GITLAB_HOST:-}" ] && [ "$host" = "$hostport" ]; then
  :
else
  exit 0
fi

# GitLab accepts any non-empty username with token authentication.
printf 'username=git\npassword=%s\n' "$token"
