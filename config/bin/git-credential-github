#!/bin/sh
#
# Git credential helper for GitHub over HTTPS.
#
# The launcher forwards GH_TOKEN (or GITHUB_TOKEN) into the container. This
# helper answers only requests for https://github.com, so a token is never
# offered to any other HTTPS remote and never travels over plain HTTP.
#
# Installed as /usr/local/bin/git-credential-github and enabled through
# config/gitconfig ([credential] helper = github).

set -eu

[ "${1:-}" = "get" ] || exit 0

token="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
[ -n "$token" ] || exit 0

protocol=""
host=""
while IFS='=' read -r key value; do
  case "$key" in
  protocol) protocol="$value" ;;
  host) host="$value" ;;
  esac
done

[ "$protocol" = "https" ] || exit 0
[ "$host" = "github.com" ] || exit 0

# GitHub accepts any non-empty username with token authentication.
printf 'username=git\npassword=%s\n' "$token"
