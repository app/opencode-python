#!/bin/sh
#
# Git credential helper for Forgejo (and Gitea) over HTTPS (and HTTP on a
# trusted network).
#
# The launcher forwards FORGEJO_URL and FORGEJO_TOKEN into the container.
# This helper answers only requests for the host from FORGEJO_URL, so a token
# is never offered to any other remote.
#
# Installed as /usr/local/bin/git-credential-forgejo and enabled through
# config/gitconfig ([credential] helper = forgejo).

set -eu

[ "${1:-}" = "get" ] || exit 0
[ -n "${FORGEJO_TOKEN:-}" ] || exit 0
[ -n "${FORGEJO_URL:-}" ] || exit 0

scheme="${FORGEJO_URL%%://*}"
hostport="${FORGEJO_URL#*://}"
hostport="${hostport%%/*}"
[ -n "$scheme" ] && [ "$scheme" != "$FORGEJO_URL" ] || exit 0
[ -n "$hostport" ] || exit 0

protocol=""
host=""
while IFS='=' read -r key value; do
  case "$key" in
  protocol) protocol="$value" ;;
  host) host="$value" ;;
  esac
done

[ "$protocol" = "$scheme" ] || exit 0
[ "$host" = "$hostport" ] || exit 0

# Forgejo and Gitea accept any non-empty username with token authentication.
printf 'username=git\npassword=%s\n' "$FORGEJO_TOKEN"
